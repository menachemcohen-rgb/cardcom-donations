<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>true</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <calloutStatus>Enabled</calloutStatus>
    <description>Cardcom API (B3.1). The body uses the merge fields {!$Credential.Cardcom_EC.ApiName} and {!$Credential.Cardcom_EC.ApiPassword}; Apex must never replace them.</description>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <label>Cardcom</label>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://secure.cardcom.solutions</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <externalCredential>Cardcom_EC</externalCredential>
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
    </namedCredentialParameters>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
</NamedCredential>
