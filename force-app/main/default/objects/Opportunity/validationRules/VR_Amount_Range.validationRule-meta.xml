<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Amount_Range</fullName>
    <active>true</active>
    <description>B2.2 via Part C C2 (Charge_Amount__c).</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = 'Micro_Donation_Pledge',
    OR(
        Charge_Amount__c &lt; $CustomMetadata.Cardcom_Setting__mdt.Default.Min_Amount__c,
        Charge_Amount__c &gt; $CustomMetadata.Cardcom_Setting__mdt.Default.Max_Amount__c
    )
)</errorConditionFormula>
    <errorDisplayField>Charge_Amount__c</errorDisplayField>
    <errorMessage>הסכום חייב להיות בין המינימום למקסימום שהוגדרו.</errorMessage>
</ValidationRule>
