<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Apply_Schedule</name>
        <label>Apply Charge Schedule</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>DonationSetup</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Result_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <outputParameters>
            <assignToReference>varOk</assignToReference>
            <name>ok</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varMessage</assignToReference>
            <name>message</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Has_Permission</name>
        <label>Has permission?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Permission_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Manage_Charge_Schedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Current_Settings_Screen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>B9.1/B9.2: shows the current charge times from Charge_Settings__c and re-schedules the Donations jobs (DonationSetup.applyScheduleInvocable). Gated by Custom Permission Manage_Charge_Schedule (also checked in Apex).</description>
    <environments>Default</environments>
    <formulas>
        <name>fAmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.AM_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fEveAmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.Eve_AM_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fEvePmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.Eve_PM_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fPmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.PM_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fReceiptTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.Receipt_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fReconcileTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.Reconcile_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fRetryMinute</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Setup.Charge_Settings__c.Retry_Minute__c})</expression>
    </formulas>
    <interviewLabel>Apply Charge Schedule {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apply Charge Schedule</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Current_Settings_Screen</name>
        <label>זמני חיוב נוכחיים</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Apply_Schedule</targetReference>
        </connector>
        <fields>
            <name>Current_Values</name>
            <fieldText>&lt;p&gt;&lt;b&gt;זמני החיוב שיוחלו (שעון ישראל):&lt;/b&gt;&lt;/p&gt;&lt;p&gt;בוקר: {!fAmTime} · ערב: {!fPmTime}&lt;/p&gt;&lt;p&gt;שישי/ערב חג: {!fEveAmTime} ו-{!fEvePmTime}&lt;/p&gt;&lt;p&gt;ניסיונות חוזרים: דקה {!fRetryMinute} בכל שעה&lt;/p&gt;&lt;p&gt;קבלות: {!fReceiptTime} · התאמה לילית: {!fReconcileTime}&lt;/p&gt;&lt;p&gt;לחיצה על "החל" מתזמנת מחדש את ריצות החיוב. חיובים שכבר תוכננו אינם משתנים.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>החל</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen</name>
        <label>שגיאה</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Text</name>
            <fieldText>&lt;p&gt;לא ניתן להחיל את זמני החיוב: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Permission_Screen</name>
        <label>אין הרשאה</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Permission_Text</name>
            <fieldText>&lt;p&gt;אין הרשאה&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Result_Screen</name>
        <label>תוצאה</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Text</name>
            <fieldText>&lt;p&gt;{!varMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Permission</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varOk</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
