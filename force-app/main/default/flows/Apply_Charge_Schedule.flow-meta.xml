<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Apply_Schedule</name>
        <label>Save Charge Times</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>ChargeTimesAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Result_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>shacharitTime</name>
            <value>
                <elementReference>Shacharit_Time</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>minchaTime</name>
            <value>
                <elementReference>Mincha_Time</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>eveShacharitTime</name>
            <value>
                <elementReference>Eve_Shacharit_Time</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>eveMinchaTime</name>
            <value>
                <elementReference>Eve_Mincha_Time</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>varOk</assignToReference>
            <name>ok</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varMessage</assignToReference>
            <name>message</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Has_Permission</name>
        <label>Has permission?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Permission_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Manage_Charge_Schedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Current_Settings_Screen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>B9.1/B9.2, D36: edits the Shacharit/Mincha charge times (regular day and eve) in Charge_Settings__c and re-schedules the Donations jobs (ChargeTimesAction). Gated by Custom Permission Manage_Charge_Schedule (also checked in Apex).</description>
    <environments>Default</environments>
    <formulas>
        <name>fAmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.AM_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fCutoff</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Setup.Charge_Settings__c.Friday_Cutoff_Hour__c})</expression>
    </formulas>
    <formulas>
        <name>fEveAmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.Eve_AM_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fEvePmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.Eve_PM_Time__c}</expression>
    </formulas>
    <formulas>
        <name>fPmTime</name>
        <dataType>String</dataType>
        <expression>{!$Setup.Charge_Settings__c.PM_Time__c}</expression>
    </formulas>
    <interviewLabel>Apply Charge Schedule {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apply Charge Schedule</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Current_Settings_Screen</name>
        <label>שעות החיוב</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Apply_Schedule</targetReference>
        </connector>
        <fields>
            <name>Intro_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;שעות החיוב (שעון ישראל, HH:mm)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;ביום רגיל יש ריצת שחרית וריצת מנחה. בערב שבת וערב חג הריצות מוקדמות, ושבת או החג מחויבים יחד עם המנחה. ריצת המנחה בערב שבת חייבת להיות לפני {!fCutoff}:00.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Shacharit_Time</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>fAmTime</elementReference>
            </defaultValue>
            <fieldText>שחרית – יום רגיל</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;למשל 08:00&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;שעה בפורמט HH:mm, למשל 08:00&lt;/p&gt;</errorMessage>
                <formulaExpression>REGEX({!Shacharit_Time}, &quot;([01][0-9]|2[0-3]):[0-5][0-9]&quot;)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Mincha_Time</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>fPmTime</elementReference>
            </defaultValue>
            <fieldText>מנחה – יום רגיל</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;למשל 20:00&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;שעה בפורמט HH:mm, למשל 08:00&lt;/p&gt;</errorMessage>
                <formulaExpression>REGEX({!Mincha_Time}, &quot;([01][0-9]|2[0-3]):[0-5][0-9]&quot;)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Eve_Shacharit_Time</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>fEveAmTime</elementReference>
            </defaultValue>
            <fieldText>שחרית – ערב שבת / ערב חג</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;למשל 06:00&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;שעה בפורמט HH:mm, למשל 08:00&lt;/p&gt;</errorMessage>
                <formulaExpression>REGEX({!Eve_Shacharit_Time}, &quot;([01][0-9]|2[0-3]):[0-5][0-9]&quot;)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Eve_Mincha_Time</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>fEvePmTime</elementReference>
            </defaultValue>
            <fieldText>מנחה – ערב שבת / ערב חג (כולל שבת או החג)</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;למשל 11:00&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;שעה בפורמט HH:mm, למשל 08:00&lt;/p&gt;</errorMessage>
                <formulaExpression>REGEX({!Eve_Mincha_Time}, &quot;([01][0-9]|2[0-3]):[0-5][0-9]&quot;)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Footer_Text</name>
            <fieldText>&lt;p&gt;בלחיצה על "שמור והחל" ריצות החיוב מתוזמנות מחדש. חיובים שכבר תוכננו אינם משתנים.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>שמור והחל</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
