        <expression>TEXT({!Get_Settings.Max_Amount__c})</expression>
    </formulas>
    <formulas>
        <name>fMin</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Settings.Min_Amount__c})</expression>
    </formulas>
