        </connector>
        <fields>
            <name>Intro_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;שליחה לכל התורמים:&lt;/b&gt; תופק ותישלח קבלה חודשית מרוכזת לכל בעלי הוראת התרומה היומית שיש להם בחודש שנבחר חיובים מוצלחים שעוד לא נכללו בקבלה. הקבלות נשלחות מ-Cardcom ישירות לתורמים.&lt;/p&gt;&lt;p&gt;תורם שכבר קיבל קבלה לחודש הזה לא יקבל קבלה נוספת. זו אותה פעולה שרצה אוטומטית בכל חודש ביום הפקת הקבלות.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Month_Input</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>fLastMonth</elementReference>
            </defaultValue>
            <fieldText>חודש הקבלה (כל יום בחודש)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <nextOrFinishButtonLabel>הפקה ושליחה לכל התורמים</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
