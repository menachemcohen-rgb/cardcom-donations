    <actionCalls>
        <name>Plan_Receipts</name>
        <label>הפקת קבלות חודשיות לכל התורמים</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>MonthlyReceiptPlanAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Result_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>allDonors</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>periodMonth</name>
            <value>
                <elementReference>Month_Input</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>varOk</assignToReference>
            <name>ok</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varMessage</assignToReference>
            <name>message</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Has_Permission</name>
        <label>יש הרשאה?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Permission_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>לא</defaultConnectorLabel>
        <rules>
            <name>Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Manage_Charge_Schedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Choose_Month_Screen</targetReference>
            </connector>
            <label>כן</label>
        </rules>
    </decisions>
    <description>N96: general button. Plans and sends the monthly receipts of a finished month for every daily-donation (Micro_Donation_Pledge) donor with a charge waiting for a receipt (MonthlyReceiptPlanAction, allDonors = true) — the same as the scheduled run on Receipt_Day_Of_Month__c. Gated by Manage_Charge_Schedule (also checked in Apex).</description>
    <environments>Default</environments>
    <formulas>
        <name>fLastMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(ADDMONTHS({!$Flow.CurrentDate}, -1)), MONTH(ADDMONTHS({!$Flow.CurrentDate}, -1)), 1)</expression>
    </formulas>
    <interviewLabel>הפקת קבלות חודשיות לכל התורמים {!$Flow.CurrentDateTime}</interviewLabel>
    <label>הפקת קבלות חודשיות לכל התורמים</label>
    <processMetadataValues>
