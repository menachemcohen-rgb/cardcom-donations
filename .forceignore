# Files Salesforce should never deploy or retrieve
package.xml
**/jsconfig.json
**/.eslintrc.json
**/__tests__/**
**/.gitkeep

# Local tooling
.sfdx/
.sf/
.localdevserver/
node_modules/

# Never push profiles wholesale; Permission Sets carry the access (B2.7)
**/profiles/**

# Non-Salesforce parts of the repo
wordpress/
docs/
spec/
scripts/
