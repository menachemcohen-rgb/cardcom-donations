<?xml version="1.0" encoding="UTF-8"?>
<!--
  Release N120: more donor fields in the email templates, a FIELDS note in every template, {!...} merge fields removed.
  The 5 donor templates carry the wording edited in production on 17.11.2026, so the deploy keeps it.
  Production:  sf project deploy validate --target-org prod -x manifest/release-n120.xml --test-level RunSpecifiedTests --tests EmailTemplatesTest DonorEmailServiceTest DonorChargeEmailServiceTest StaffAlertServiceTest PledgeRollupServiceTest
               then sf project deploy quick --job-id <id> --target-org prod
  Stop the Donations jobs first (DonationSetup.request('UNSCHEDULE_ALL');) and schedule them again after (SCHEDULE_ALL).
-->
