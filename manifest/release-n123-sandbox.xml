<?xml version="1.0" encoding="UTF-8"?>
<!--
  Release N123 (sandbox): GET /donations/settings for the WordPress form's amount buttons and min/max (plugin 1.6.0).
  Deploy the Apex first; plugin 1.6.0 falls back to wp-config/defaults until the endpoint exists.
  Not in this manifest, by design: Cardcom_Setting.Default (edit Amount_Presets__c / Min / Max in Setup, never redeploy the record).
  Donations_Integration is deployed whole: it adds class access to DonationSettingsResource for the integration user.
  sf project deploy start --target-org sandbox -x manifest/release-n123-sandbox.xml --test-level RunSpecifiedTests --tests DonationSettingsResourceTest
  No scheduled job uses these classes, so the Donations jobs don't need to be stopped.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>DonationSettingsResource</members>
        <members>DonationSettingsResourceTest</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>Donations_Integration</members>
        <name>PermissionSet</name>
    </types>
    <version>62.0</version>
</Package>
