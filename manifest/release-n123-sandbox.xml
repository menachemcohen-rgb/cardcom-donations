<?xml version="1.0" encoding="UTF-8"?>
<!--
  Release N123 (sandbox): GET /donations/settings for the WordPress form's amount buttons and min/max (plugin 1.6.0).
  Deploy the Apex first; plugin 1.6.0 falls back to wp-config/defaults until the endpoint exists.
  Not in this manifest, by design: Cardcom_Setting.Default (edit Amount_Presets__c / Min / Max in Setup, never redeploy the record).
  Donations_Integration is deployed whole: it adds class access to DonationSettingsResource for the integration user.
  sf project deploy start --target-org sandbox -x manifest/release-n123-sandbox.xml --test-level RunSpecifiedTests --tests DonationSettingsResourceTest AmountPresetsActionTest StaffAlertServiceTest
  Also: the "Amount buttons" screen (flow Edit_Amount_Presets, permission set Donations_Amount_Presets) that saves Amount_Presets__c.
  StaffAlertService is redeployed (new amountPresetsFailed); stop the Donations jobs first (UNSCHEDULE_ALL) and schedule again after.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>AmountPresetsAction</members>
        <members>AmountPresetsActionTest</members>
        <members>DonationSettingsResource</members>
        <members>DonationSettingsResourceTest</members>
        <members>StaffAlertService</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>Manage_Amount_Presets</members>
        <name>CustomPermission</name>
    </types>
    <types>
        <members>Edit_Amount_Presets</members>
        <name>Flow</name>
    </types>
    <types>
        <members>Donations_Amount_Presets</members>
        <members>Donations_Integration</members>
        <name>PermissionSet</name>
    </types>
    <version>62.0</version>
</Package>
