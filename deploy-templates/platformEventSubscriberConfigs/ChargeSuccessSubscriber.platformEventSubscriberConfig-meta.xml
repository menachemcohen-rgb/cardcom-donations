<?xml version="1.0" encoding="UTF-8"?>
<!-- Template (B6.9.2, B10 step 9): runs ChargeSuccessTrigger (donor thank-you emails) as the integration user.
     Batch size 10 keeps one transaction under the 10 sendEmail calls / 1,000 messages limits (spec-consistency N67). -->
<PlatformEventSubscriberConfig xmlns="http://soap.sforce.com/2006/04/metadata">
    <batchSize>10</batchSize>
    <masterLabel>ChargeSuccessSubscriber</masterLabel>
    <platformEventConsumer>ChargeSuccessTrigger</platformEventConsumer>
    <user>INTEGRATION_USERNAME</user>
</PlatformEventSubscriberConfig>
